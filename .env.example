# Banana Project Web Frontend Environment Configuration Template
# Copy this file to .env.development or .env.production for local overrides

# Leave empty to use the Vue dev-server proxy (vue.config.js -> 127.0.0.1:8082).
# Set to an absolute API URL (e.g. https://api.ayurami.com) to bypass the proxy.
VUE_APP_API_URL=
